# Public URL of the site (used for canonical URLs, sitemap, Open Graph and structured data).
NEXT_PUBLIC_SITE_URL="https://kilolua.co.ke"

# Optional: Google Search Console "HTML tag" verification token (the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Optional: Twitter/X handle for cards, e.g. @kilolua
NEXT_PUBLIC_TWITTER_HANDLE=""

# --- Contact form email (SMTP) ---------------------------------------------
# Use the mailbox settings of the account that owns info@kilolua.co.ke
# (cPanel, Google Workspace, Zoho, Microsoft 365, ...). Without SMTP_HOST the
# form shows an error with the email address as a fallback; nothing is sent.
SMTP_HOST=""
SMTP_PORT="465"
# "true" for port 465 (SSL), "false" for 587 (STARTTLS). Defaults to true on 465.
SMTP_SECURE="true"
SMTP_USER="info@kilolua.co.ke"
SMTP_PASS=""

# Address the "From" header uses (must be allowed by your SMTP account). Defaults to SMTP_USER.
CONTACT_FROM="info@kilolua.co.ke"
# Where enquiries are delivered. Defaults to info@kilolua.co.ke.
CONTACT_TO="info@kilolua.co.ke"
# Optional: route buyer / farmer enquiries to different inboxes.
# CONTACT_TO_BUYER=""
# CONTACT_TO_FARMER=""
